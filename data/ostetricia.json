    "fonte": "who-2025"
  },
  "pph_refrattaria": {
    "misure_temporizzanti": [
      "compressione bimanuale uterina",
      "compressione aortica esterna",
      "NASG (indumento anti-shock non pneumatico)",
      "tamponamento con palloncino intrauterino (dopo aver escluso trauma e ritenzione placentare)"
