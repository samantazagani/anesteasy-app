{
  "calcolatori": [
    {
      "id": "correzione_sodio",
      "nome": "Sodio corretto per glicemia",
      "formula": "Na_corretto = Na_misurato + 0.016 * (glicemia_mg_dl - 100)",
      "note": "alcuni usano 0.024 per glicemie molto alte",
      "categoria": "elettroliti",
      "ordine": 1
    },
    {
      "id": "gap_osmolare",
      "nome": "Gap osmolare",
      "formula": "osm_calcolata = 2*Na + glicemia/18 + BUN/2.8 ; gap = osm_misurata - osm_calcolata",
      "note": "normale <10",
      "categoria": "elettroliti",
      "ordine": 2
    },
    {
      "id": "deficit_sodio",
      "nome": "Deficit di sodio",
      "formula": "deficit_mmol = (Na_target - Na_attuale) * acqua_corporea_totale ; ACT = peso * 0.6 (uomo) / 0.5 (donna)",
      "note": "IPOnatriemia: correggere max 6-8 mmol/L in 24h (<=6 se high-risk: Na<115, etilismo, malnutrizione, ipoK, epatopatia). Vedi calcolatore Adrogue-Madias.",
      "categoria": "elettroliti",
      "ordine": 3
    },
    {
      "id": "correzione_sodio_adrogue",
      "nome": "Correzione Na sicura (Adrogue-Madias)",
      "categoria": "elettroliti",
      "formula": "ACT = peso * coeff; deltaNa_per_litro = (Na_soluzione - Na_paziente) / (ACT + 1); volume_L_24h = target_deltaNa_24h / deltaNa_per_litro; velocita_ml_h = volume_L_24h * 1000 / 24",
      "coeff_ACT": {
        "uomo": 0.6,
        "donna_o_uomo_anziano": 0.5,
        "donna_anziana": 0.45
      },
      "soluzioni_Na_mEq_L": {
        "ipertonica_3%": 513,
        "fisiologica_0.9%": 154
      },
      "input": [
        "Na_paziente",
        "peso",
        "sesso_eta",
        "soluzione",
        "target_deltaNa_24h"
      ],
      "output": [
        "deltaNa_per_litro",
        "velocita_ml_h"
      ],
      "limiti_correzione": {
        "target_24h": "6-8 mEq/L",
        "high_risk_24h": "<= 6 mEq/L",
        "limite_48h": "< 18 mEq/L",
        "fattori_high_risk": "Na < 115, etilismo, malnutrizione, ipokaliemia, epatopatia avanzata"
      },
      "sicurezza": [
        "la formula SOTTOSTIMA il rialzo reale (ignora diuresi/perdite di acqua libera): e' solo una stima iniziale -> RICONTROLLARE il Na ogni 2-4 h",
        "sintomi neurologici gravi (convulsioni, coma): boli di ipertonica 3% 100-150 ml in 10-20 min, ripetibili fino a un rialzo di 4-6 mEq/L, poi STOP (il tetto delle 24h vale comunque)",
        "se overcorrezione: ri-abbassare con glucosata 5% +/- desmopressina (DDAVP)"
      ],
      "esempio": "donna anziana 60 kg, Na 110, ipertonica 3%: ACT = 60*0.45 = 27; deltaNa/L = (513-110)/(27+1) = 14.4; target +6 -> 6/14.4*1000 = 416 ml/24h -> ~17 ml/h",
      "fonte": "Adrogue-Madias; limiti da linee guida (panel USA 2013 / europee 2014), tetto 6-8/24h",
      "ordine": 4
    },
    {
      "id": "deficit_idrico",
      "nome": "Deficit idrico (ipernatriemia)",
      "formula": "deficit_L = ACT * ((Na_attuale/140) - 1) ; ACT = peso * 0.6/0.5",
      "input": [
        "peso",
        "sesso",
        "Na_attuale"
      ],
      "categoria": "elettroliti",
      "note": "IPERnatriemia: abbassare il Na max ~10 mmol/L in 24h (circa 0.5 mmol/L/h) per evitare edema cerebrale",
      "ordine": 5
    },
    {
      "id": "correzione_potassio",
      "nome": "Deficit di potassio (stima)",
      "formula": "stima: ogni 0.1 mmol/L sotto 4.0 ~ deficit 100-200 mmol totali",
      "note": "stima grossolana, guidare con emogas seriati",
      "categoria": "elettroliti",
      "ordine": 6
    },
    {
      "id": "calcio_corretto",
      "nome": "Calcio corretto per albumina",
      "formula": "Ca_corretto = Ca_misurato + 0.8 * (4.0 - albumina_g_dl)",
      "categoria": "elettroliti",
      "ordine": 7
    },
    {
      "id": "gamma",
      "nome": "Gamma <-> ml/h",
      "formula": "ml/h = (dose_mcg_kg_min * peso_kg * 60) / concentrazione_mcg_ml ; inverso: mcg_kg_min = (ml_h * concentrazione_mcg_ml) / (peso_kg * 60)",
      "input": [
        "dose_mcg_kg_min",
        "peso_kg",
        "concentrazione_mcg_ml"
      ],
      "categoria": "infusioni"
    },
    {
      "id": "infusione_da_dose_oraria",
      "nome": "ml/h da dose (mg/mcg)",
      "categoria": "infusioni",
      "descrizione": "Conversione bidirezionale dose <-> velocita pompa, con unita di massa selezionabili (mg o mcg) per concentrazione e dose. Mostra le equivalenze pronte.",
      "input": [
        {
          "campo": "quantita_farmaco",
          "label": "Quantita farmaco",
          "unita": [
            "mg",
            "mcg"
          ]
        },
        {
          "campo": "volume_totale_ml",
          "label": "Volume totale",
          "unita": "ml"
        },
        {
          "campo": "dose",
          "label": "Dose",
          "unita": [
            "mg/h",
            "mg/min",
            "mcg/h",
            "mcg/min"
          ]
        },
        {
          "campo": "velocita_ml_h",
          "label": "Velocita pompa",
          "unita": "ml/h"
        }
      ],
      "bidirezionale": "impostando la dose si calcola ml/h; impostando ml/h si calcola la dose (nell'unita scelta)",
      "formula": "conc_mcg_ml = quantita_in_mcg / volume_ml ; dose_mcg_min = converti(dose, unita) ; ml_h = (dose_mcg_min / conc_mcg_ml) * 60 ; inverso: dose_mcg_min = (ml_h / 60) * conc_mcg_ml",
      "conversioni": {
        "massa": "mg = mcg / 1000",
        "tempo": "per min <-> per h (*60 / :60)",
        "concentrazione_mostrata": "sia mg/ml sia mcg/ml"
      },
      "output": [
        "velocita_ml_h",
        "equivalenze: ml/h, mg/min, mcg/min, mg/h, mcg/h"
      ],
      "note": "NON per kg: per i gamma (mcg/kg/min) usare il calcolatore 'gamma'. Esempio: 250 mg in 50 ml (=5 mg/ml), 1 mg/min -> 12 ml/h.",
      "data_revisione": "2026-09-30"
    },
    {
      "id": "map",
      "nome": "Pressione arteriosa media",
      "formula": "MAP = (PAS + 2*PAD) / 3",
      "categoria": "emodinamica"
    },
    {
      "id": "shock_index",
      "nome": "Shock index",
      "formula": "SI = FC / PAS",
      "note": "normale 0.5-0.7; >0.9 allarme",
      "categoria": "emodinamica"
    },
    {
      "id": "aa_gradient",
      "nome": "Gradiente Alveolo-arterioso",
      "formula": "A-a = (FiO2*(Patm - 47) - PaCO2/0.8) - PaO2 ; a aria ambiente ~ 150 - PaCO2/0.8 - PaO2",
      "note": "normale ~ eta/4 + 4",
      "categoria": "respiratorio"
    },
    {
      "id": "anion_gap",
      "nome": "Anion gap",
      "formula": "AG = Na - (Cl + HCO3) ; corretto per albumina: AG + 2.5*(4.0 - albumina_g_dl)",
      "note": "normale 8-12",
      "categoria": "equilibrio acido-base"
    },
    {
      "id": "winter",
      "nome": "Compenso respiratorio atteso (Winter)",
      "formula": "PaCO2_atteso = 1.5 * HCO3 + 8 (+/- 2)",
      "note": "acidosi metabolica",
      "categoria": "equilibrio acido-base"
    },
    {
      "id": "clearance_creatinina",
      "nome": "Clearance creatinina (Cockcroft-Gault)",
      "formula": "ClCr = ((140 - eta) * peso_kg) / (72 * creatinina_mg_dl) ; * 0.85 se donna",
      "input": [
        "eta",
        "peso_kg",
        "creatinina_mg_dl",
        "sesso"
      ],
      "categoria": "renale"
    },
    {
      "id": "egfr_ckdepi",
      "nome": "eGFR (CKD-EPI 2021, race-free)",
      "formula": "eGFR = 142 * min(Scr/k,1)^a * max(Scr/k,1)^(-1.200) * 0.9938^eta * (1.012 se donna) ; k = 0.7 (donna)/0.9 (uomo); a = -0.241 (donna)/-0.302 (uomo); Scr = creatinina in mg/dl",
      "input": [
        "eta",
        "sesso",
        "creatinina_mg_dl"
      ],
      "output": "ml/min/1.73m2",
      "note": "equazione senza fattore razza (2021); diversa dalla Cockcroft-Gault (che stima la clearance in ml/min per il dosaggio farmaci)",
      "fonte": "CKD-EPI 2021 (Inker NEJM 2021)",
      "categoria": "renale"
    },
    {
      "id": "qtc",
      "nome": "QTc (Bazett)",
      "formula": "QTc = QT_ms / sqrt(RR_s) ; RR_s = 60/FC",
      "note": "prolungato >450 (uomo) / >470 (donna)",
      "categoria": "cardiologia"
    },
    {
      "id": "cpp",
      "nome": "Pressione di perfusione cerebrale (CPP)",
      "formula": "CPP = MAP - ICP",
      "input": [
        "MAP",
        "ICP"
      ],
      "output": "mmHg",
      "note": "target tipico 60-70 mmHg; MAP misurata a livello del trago",
      "fonte": "riferimento standard",
      "categoria": "neuro"
    },
    {
      "id": "pia_conversione",
      "nome": "PIA: conversione cmH2O <-> mmHg",
      "formula": "mmHg = cmH2O / 1.36 ; cmH2O = mmHg * 1.36",
      "input": [
        "valore",
        "unita_di_partenza"
      ],
      "output": "valore convertito",
      "note": "PIA (pressione intra-addominale) misurata in vescica. Normale 5-7 mmHg; ipertensione intra-addominale >12 mmHg; sindrome compartimentale addominale >20 mmHg",
      "categoria": "addome"
    },
    {
      "id": "rotem",
      "nome": "Interpretazione ROTEM",
      "categoria": "coagulazione",
      "tipo": "interprete",
      "descrizione": "Paziente sanguinante: dai valori ROTEM suggerisce l'azione nella sequenza clinica. Modalita interattiva (inserisci i valori -> azione + dose sul peso) e riferimenti statici.",
      "input": [
        {
          "campo": "peso",
          "label": "Peso",
          "unita": "kg",
          "uso": "dose"
        },
        {
          "campo": "extem_ml",
          "label": "EXTEM ML",
          "unita": "%"
        },
        {
          "campo": "fibtem_a5",
          "label": "FIBTEM A5",
          "unita": "mm"
        },
        {
          "campo": "extem_a5",
          "label": "EXTEM A5",
          "unita": "mm"
        },
        {
          "campo": "extem_ct",
          "label": "EXTEM CT",
          "unita": "s"
        },
        {
          "campo": "intem_ct",
          "label": "INTEM CT",
          "unita": "s"
        },
        {
          "campo": "heptem_ct",
          "label": "HEPTEM CT",
          "unita": "s"
        }
      ],
      "sequenza": [
        "fibrinolisi",
        "fibrinogeno",
        "piastrine",
        "fattori",
        "eparina"
      ],
      "nota_sequenza": "Leggere FIBTEM A5 PRIMA di EXTEM CT: il CT e interpretabile solo se il fibrinogeno e adeguato.",
      "regole": [
        {
          "step": 1,
          "nome": "Iperfibrinolisi",
          "colore": "lisi",
          "condizione": "extem_ml > 15",
          "interpretazione": "iperfibrinolisi (confermare con APTEM)",
          "azione": "Acido tranexamico",
          "dose_mg_kg": [
            15,
            20
          ],
          "dose_fissa": "1 g"
        },
        {
          "step": 2,
          "nome": "Fibrinogeno basso",
          "colore": "fibrinogeno",
          "condizione": "fibtem_a5 < 10",
          "nota_condizione": "obiettivo piu alto in ostetricia/cardiochirurgia (A5 < 12)",
          "interpretazione": "deficit di fibrinogeno",
          "azione": "Fibrinogeno concentrato (o crioprecipitato)",
          "dose_mg_kg": [
            25,
            50
          ]
        },
        {
          "step": 3,
          "nome": "Firmezza bassa (piastrine)",
          "colore": "piastrine",
          "condizione": "extem_a5 < 35 AND fibtem_a5 >= 10",
          "condizione_alt": "se extem_a5 < 35 ma fibtem_a5 < 10 -> correggere PRIMA il fibrinogeno, poi rivalutare le piastrine",
          "interpretazione": "deficit piastrinico (con fibrinogeno adeguato)",
          "azione": "Piastrine (1 pool)"
        },
        {
          "step": 4,
          "nome": "Deficit di fattori",
          "colore": "fattori",
          "condizione": "extem_ct > 80",
          "nota_condizione": "interpretare dopo aver corretto il fibrinogeno",
          "interpretazione": "deficit di fattori della coagulazione",
          "azione": "PCC (o plasma)",
          "dose_ui_kg": 25
        },
        {
          "step": 5,
          "nome": "Eparina residua",
          "colore": "eparina",
          "condizione": "intem_ct > 240 AND (intem_ct / heptem_ct) > 1.25",
          "interpretazione": "effetto eparinico residuo (HEPTEM corregge INTEM)",
          "azione": "Protamina (secondo eparina residua)"
        }
      ],
      "riferimenti": {
        "parametri": [
          {
            "sigla": "CT",
            "significato": "clotting time - avvio del coagulo = fattori (e anticoagulanti)"
          },
          {
            "sigla": "CFT / alpha",
            "significato": "cinetica di formazione = fibrinogeno + piastrine"
          },
          {
            "sigla": "A5 / A10",
            "significato": "fermezza precoce - decisione rapida, predice l'MCF"
          },
          {
            "sigla": "MCF",
            "significato": "fermezza massima = piastrine + fibrinogeno + FXIII"
          },
          {
            "sigla": "ML / LI30",
            "significato": "lisi del coagulo = fibrinolisi"
          }
        ],
        "test": [
          {
            "sigla": "EXTEM",
            "significato": "via estrinseca - quadro globale"
          },
          {
            "sigla": "INTEM",
            "significato": "via intrinseca (+ effetto eparina)"
          },
          {
            "sigla": "FIBTEM",
            "significato": "contributo del fibrinogeno (piastrine inibite)"
          },
          {
            "sigla": "APTEM",
            "significato": "smaschera l'iperfibrinolisi (confronto con EXTEM)"
          },
          {
            "sigla": "HEPTEM",
            "significato": "smaschera l'eparina residua (confronto con INTEM)"
          }
        ],
        "valori_normali": [
          {
            "test": "EXTEM",
            "range": "CT 38-79 s; A10 43-65 mm; MCF 50-72 mm; ML <15%"
          },
          {
            "test": "INTEM",
            "range": "CT 100-240 s; MCF 50-72 mm"
          },
          {
            "test": "FIBTEM",
            "range": "A10 7-23 mm; MCF 9-25 mm"
          }
        ],
        "_nota_valori": "valori normali indicativi, dipendono dal dispositivo"
      },
      "fonte": "algoritmi A5-guidati (Gorlinger et al.) / linee guida sanguinamento perioperatorio",
      "data_revisione": "2026-09-29",
      "_soglie_nota": "soglie e dosi modificabili; da confermare col protocollo del reparto"
    }
  ],
  "_ordine_elettroliti": "La sezione elettroliti segue il flusso di un caso clinico: 1) Na corretto per glicemia -> 2) gap osmolare -> 3) deficit di sodio -> 4) Adrogue-Madias (correzione sicura) -> 5) deficit idrico (ipernatriemia) -> 6) potassio -> 7) calcio. Ordinare per il campo 'ordine'"
}