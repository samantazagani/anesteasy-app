  "calcolo_pesi": {
    "_bug_noto": "Se l'app mostra ancora IBW/BMI errati in pediatria, il fix e nel CODICE: applicare questo algoritmo quando la categoria e pediatrica.",
    "algoritmo": [
      "1. categoria pediatrica se eta < ~15 anni (o sotto la soglia adulto configurata)",
      "2. BMI = peso_kg / (altezza_m)^2  (STESSA formula dell'adulto; ma NON usare i cutoff 25/30: in pediatria si interpreta per percentile)",
      "3. peso ideale (IBW) pediatrico: NON usare la formula di Devine (adulto, richiede altezza >152 cm). Usare Traub-Johnson: IBW_kg = 2.396 * exp(0.01863 * altezza_cm)",
      "4. peso di riferimento per i farmaci = peso REALE (TBW) di default",
      "5. NON applicare la regola adulto 'BMI>=30 -> IBW'"
    ],
    "esempi_IBW_traub": [
      {
        "altezza_cm": 100,
        "IBW_kg_circa": 15.4
      },
      {
        "altezza_cm": 120,
        "IBW_kg_circa": 22.4
      },
      {
        "altezza_cm": 150,
        "IBW_kg_circa": 39.2
      }
    ],
    "verificato": false,
    "fonte": "bozza (Traub-Johnson)"
  },
  "calcolatori": [
    {
      "id": "vt_pediatrico",
      "nome": "Volume corrente pediatrico",
      "formula": "Vt_ml = ml_kg * peso_kg ; ml_kg tipico 6-8 (usare peso ideale/atteso se obeso)",
      "input": [
        "peso_kg",
        "ml_kg"
      ],
      "output": "ml",
      "note": "6-8 ml/kg; in ARDS 5-6 ml/kg",
      "verificato": false,
      "fonte": "bozza"
    },
    {
      "id": "liquidi_mantenimento_ml_h",
      "nome": "Liquidi di mantenimento (ml/h) - Holliday-Segar 4-2-1",
      "formula": "ml_h = 4*min(peso,10) + 2*min(max(peso-10,0),10) + 1*max(peso-20,0)",
      "input": [
        "peso_kg"
      ],
      "output": "ml/h",
      "esempio": "peso 25 kg -> 4*10 + 2*10 + 1*5 = 65 ml/h",
      "verificato": false,
      "fonte": "bozza"
    }
