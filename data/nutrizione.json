    },
    "verificato": false, "fonte": "espen-2023"
  },

  "percentuale_fase": {
    "_nota": "nel critico si raggiunge il pieno regime in qualche giorno; la % si applica al target CALORICO e PROTEICO",
    "fasi": [
      {"fase": "acuta precoce (giorni 1-2)", "percentuale_target": "<=70%", "motivo": "evitare overfeeding/refeeding"},
      {"fase": "acuta tardiva (>= giorno 3)", "percentuale_target": "80-100%"},
      {"fase": "recupero", "percentuale_target": "100% (o piu se catabolismo)"}
    ],
    "campo_app": "percentuale_target selezionabile dall'utente (default suggerito per fase)",
    "verificato": false, "fonte": "espen-2023"
  },

  "proteine": {
    "regime_per_bmi": {
      "non_obeso": {"g_kg": 1.3, "range": [1.2, 2.0], "peso": "reale", "note": "progressivo; CRRT/ustionato fino a 2.0-2.5"},
      "obeso_BMI_30-40": {"g_kg": 2.0, "peso": "IBW", "fonte": "aspen-2016"},
      "obeso_BMI>=40": {"g_kg": 2.5, "peso": "IBW", "fonte": "aspen-2016"}
    },
    "verificato": false, "fonte": "espen-2023"
  },

  "propofol_calorie": {
    "descrizione": "il propofol e in emulsione lipidica 10%: apporta calorie e lipidi da SOTTRARRE dal fabbisogno da somministrare",
    "kcal_per_ml": 1.1,
    "lipidi_g_per_ml": 0.1,
    "formula_kcal_die": "kcal_propofol = ml_h * 24 * 1.1",
    "formula_lipidi_g_die": "lipidi_propofol_g = ml_h * 24 * 0.1",
    "nota": "vale per propofol 1% e 2% (entrambi veicolo lipidico 10%)",
    "verificato": false, "fonte": "bozza"
  },

  "calcolatore_target": {
    "descrizione": "flusso completo del calcolo nutrizionale",
    "passi": [
      "1. BMI da peso/altezza -> scegli il regime (normocalorico vs obeso ipocalorico-iperproteico)",
      "2. kcal_target = kcal_kg * peso_di_riferimento (reale o IBW secondo regime)",
      "3. kcal_fase = kcal_target * percentuale_fase (es. 70%)",
      "4. kcal_propofol = ml_h_propofol * 24 * 1.1",
      "5. kcal_da_nutrizione = kcal_fase - kcal_propofol",
      "6. proteine_target_g = g_kg(regime) * peso_di_riferimento  (le proteine NON si riducono con la fase quanto le calorie)"
    ],
    "verificato": false, "fonte": "espen-2023"
  },

  "fabbisogno_idrico": {"ml_kg_die": [30, 35], "verificato": false, "fonte": "bozza"},
