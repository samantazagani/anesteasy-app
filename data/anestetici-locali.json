  "tossicita_additiva": {
    "regola": "con AL misti la tossicita si somma come % della dose max di ciascuno (es. 50% max lido + 50% max ropi = 100%)",
    "percentuale_usata": "somma( dose_data_i / dose_max_i )  per ogni AL usato",
    "margine_percentuale": "1 - percentuale_usata",
    "margine_ml": "per l'AL scelto a concentrazione C: margine_ml = (margine_percentuale * dose_max_AL_scelto) / conc_mg_ml",
    "esempio": "usato 60% del tetto; scelgo ropivacaina 0.2% (2 mg/ml), dose_max ropi 200 mg -> margine = 0.4*200/2 = 40 ml ancora somministrabili"
  },
  "calcolatori": [
    {
      "id": "volume_max",
      "nome": "Volume massimo iniettabile",
      "formula": "dose_max_mg = min(mg_kg*peso, tetto_assoluto_mg); volume_max_ml = dose_max_mg / conc_mg_ml; residuo_mg = dose_max_mg - gia_somministrato_mg; residuo_ml = residuo_mg / conc_mg_ml",
      "input": [
        "anestetico",
        "con_adrenalina",
        "peso",
        "concentrazione_percento",
        "gia_somministrato_mg (opzionale)"
      ],
      "note": "concentrazione %: usare conversione_concentrazione (1% = 10 mg/ml)",
      "output": [
        "volume_max_ml",
        "residuo_ml (margine ancora somministrabile)"
      ]
    },
    {
      "id": "diluizione",
      "nome": "Diluizione da fiala",
      "formula": "volume_da_prelevare_ml = (conc_target_mg_ml * volume_finale_ml) / conc_fiala_mg_ml; fisiologica_ml = volume_finale_ml - volume_da_prelevare_ml",
      "input": [
        "conc_fiala_mg_ml",
        "conc_target_mg_ml",
        "volume_finale_ml"
      ],
      "note": "usa conversione_concentrazione per %<->mg/ml; avvisare se ml_da_prelevare supera il volume delle fiale disponibili (calcolare quante fiale servono)"
    },
    {
      "id": "elastomero",
      "nome": "Riempimento elastomero",
      "formula": "mg_totali = conc_target_mg_ml * volume_totale_ml; n_fiale = mg_totali / mg_per_fiala; volume_AL_ml = n_fiale * volume_fiala_ml; fisiologica_ml = volume_totale_ml - volume_AL_ml",
      "input": [
        "conc_target_mg_ml",
        "volume_totale_ml",
        "mg_per_fiala",
        "volume_fiala_ml"
      ],
      "note": "mg_per_fiala e volume_fiala si possono precompilare da preparazioni_commerciali"
    }
  ],
